{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "44rem",
			"wideSize": "68rem"
		},
		"color": {
			"custom": true,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "ink", "color": "#eef3fa", "name": "Papierweiß" },
				{ "slug": "ink-soft", "color": "#c3d0e2", "name": "Gedämpft" },
				{ "slug": "muted", "color": "#8698b3", "name": "Nebel" },
				{ "slug": "base", "color": "#070b12", "name": "Polarnacht" },
				{ "slug": "base-soft", "color": "#0c131f", "name": "Tiefsee" },
				{ "slug": "mint", "color": "#4fe0b0", "name": "Nordlicht" },
				{ "slug": "blue", "color": "#39a0ff", "name": "Fjordblau" },
				{ "slug": "violet", "color": "#a86bff", "name": "Mitternacht" }
			],
			"gradients": [
				{
					"slug": "aurora",
					"name": "Aurora",
					"gradient": "linear-gradient(120deg, #4fe0b0 0%, #39a0ff 45%, #a86bff 100%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, ui-serif, serif"
				},
				{
					"slug": "body",
					"name": "Fließtext",
					"fontFamily": "ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem", "name": "Klein" },
				{ "slug": "medium", "size": "1.075rem", "name": "Normal" },
				{ "slug": "large", "size": "clamp(1.2rem, 1.1rem + 0.5vw, 1.45rem)", "name": "Groß" },
				{ "slug": "x-large", "size": "clamp(1.5rem, 1.32rem + 0.9vw, 2.05rem)", "name": "Sehr groß" },
				{ "slug": "xx-large", "size": "clamp(1.9rem, 1.55rem + 1.7vw, 2.9rem)", "name": "Riesig" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "svh", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink-soft)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--mint)" }
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.12"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			}
		}
	}
}
